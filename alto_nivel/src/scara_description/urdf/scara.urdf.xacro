<?xml version="1.0"?>
<!-- SCARA RRP. Unidades de ROS: metros y radianes. -->
<robot name="scara" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Medidas del robot, sacadas de tu tabla DH (mm -> m) -->
  <xacro:property name="h1"    value="0.12525"/>  <!-- S1: base -> eje de R1 -->
  <xacro:property name="l1"    value="0.12505"/>  <!-- a12: eje R1 -> eje R2 -->
  <xacro:property name="h2"    value="0.044"/>    <!-- S2: R2 está 44 mm más arriba que R1 -->
  <xacro:property name="l2"    value="0.12255"/>  <!-- a23: eje R2 -> eje del prismático -->
  <xacro:property name="h3"    value="0.14675"/>  <!-- -S3: la cabeza del prismático está 146.75 mm sobre R2 -->
  <xacro:property name="tool"  value="0.222"/>    <!-- S4: de la cabeza a la punta, con el prismático en 0 -->
  <xacro:property name="p_max" value="0.085"/>    <!-- carrera del prismático (85 mm, igual que axis_config.h) -->

  <!-- Límites: los mismos de axis_config.h -->
  <xacro:property name="r_min" value="-1.57"/>
  <xacro:property name="r_max" value="1.57"/>

  <!-- Material solo para que se vea en RViz -->
  <material name="gris"><color rgba="0.6 0.6 0.6 1"/></material>
  <material name="azul"><color rgba="0.2 0.4 0.8 1"/></material>

  <!-- ===== Eslabones (solo la parte visual; lo que importa son los origin de las juntas) ===== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${h1/2}"/>
      <geometry><cylinder radius="0.03" length="${h1}"/></geometry>
      <material name="gris"/>
    </visual>
  </link>

  <link name="link_1">
    <visual>
      <origin xyz="${l1/2+0.0025} 0 0"/>
      <geometry><box size="${l1+0.035} 0.04 0.02"/></geometry>
      <material name="azul"/>
    </visual>
    <visual>   <!-- poste que sube los 44 mm hasta R2 -->
      <origin xyz="${l1} 0 ${h2/2}"/>
      <geometry><cylinder radius="0.02" length="${h2}"/></geometry>
      <material name="azul"/>
    </visual>
  </link>

  <link name="link_2">
    <visual>
      <origin xyz="${l2/2-0.0025} 0 0"/>
      <geometry><box size="${l2+0.035} 0.04 0.02"/></geometry>
      <material name="gris"/>
    </visual>
    <visual>   <!-- columna hasta la cabeza del prismático -->
      <origin xyz="${l2} 0 ${h3/2}"/>
      <geometry><cylinder radius="0.015" length="${h3}"/></geometry>
      <material name="gris"/>
    </visual>
  </link>

  <link name="link_p">   <!-- la varilla que baja y sube -->
    <visual>
      <origin xyz="0 0 ${-tool/2}"/>
      <geometry><cylinder radius="0.008" length="${tool}"/></geometry>
      <material name="azul"/>
    </visual>
  </link>

  <link name="tool0"/>   <!-- la punta: este es el punto que usará la IK -->

  <!-- ===== Juntas (los nombres son los que usará todo ROS) ===== -->
  <joint name="joint_r1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 ${h1}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${r_min}" upper="${r_max}" effort="10" velocity="1.0"/>
  </joint>

  <joint name="joint_r2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="${l1} 0 ${h2}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${r_min}" upper="${r_max}" effort="10" velocity="1.0"/>
  </joint>

  <!-- El origen es la cabeza (z = 316 mm). Supuesto: p positivo = la punta BAJA (axis 0 0 -1).
       Si en tu robot es al revés, cambia el axis a "0 0 1". -->
  <joint name="joint_p" type="prismatic">
    <parent link="link_2"/>
    <child link="link_p"/>
    <origin xyz="${l2} 0.001 ${h3}"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0.0" upper="${p_max}" effort="50" velocity="0.01"/>
  </joint>

  <joint name="joint_tool" type="fixed">
    <parent link="link_p"/>
    <child link="tool0"/>
    <origin xyz="0 0 ${-tool}"/>
  </joint>

</robot>
